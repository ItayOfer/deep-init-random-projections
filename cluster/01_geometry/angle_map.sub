#!/bin/bash
#SBATCH --job-name=angle_map
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python cluster/01_geometry/run_angle_map.py \
    --init-strategies he,orthogonal_he,row_centered_he_var_adj \
    --dim 784 \
    --n-angles 40 \
    --n-pairs 300 \
    --n-seeds 5 \
    --output reports/results/angle_map.json"
