#!/bin/bash
#SBATCH --job-name=geometry_pb
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=%x-%j.out

# Geometry benchmark including the product-balanced initializer.
# Measures k-NN accuracy, distance correlation, effective dimensionality
# at various depths for all candidate initializers.

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

# Fashion-MNIST
srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python cluster/01_geometry/run_geometry_benchmark.py \
    --dataset fashion_mnist \
    --depths 5,10,15,20 \
    --init-strategies he,orthogonal_he,row_centered_he_var_adj,row_centered_product_balanced,row_centered_forward_balanced \
    --num-samples 2000 \
    --device cuda \
    --output reports/results/geometry_product_balanced_fmnist.json"

# CIFAR-10
srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python cluster/01_geometry/run_geometry_benchmark.py \
    --dataset cifar10 \
    --depths 5,10,15,20 \
    --init-strategies he,orthogonal_he,row_centered_he_var_adj,row_centered_product_balanced,row_centered_forward_balanced \
    --num-samples 2000 \
    --device cuda \
    --output reports/results/geometry_product_balanced_cifar10.json"
