#!/bin/bash
#SBATCH --job-name=fnn_he_train
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=18:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/02_he_tuning/run_supervised_grid.py \
    --datasets cifar10,fashion_mnist \
    --architectures fc \
    --depths 30,50,100 \
    --init-strategies he \
    --batch-norm false,true \
    --fc-hidden-dim 500 \
    --epochs 120 \
    --min-epochs 20 \
    --target-train-accuracy 0.995 \
    --target-patience 5 \
    --target-metric eval_train_accuracy \
    --batch-size 128 \
    --eval-batch-size 256 \
    --learning-rate 1e-3 \
    --optimizer adam \
    --device cuda \
    --normalize-inputs \
    --log-every-epoch \
    --output reports/results/fnn_he_bn_evaltrain_training.json"
