#!/bin/bash
#SBATCH --job-name=fnn_he_best12
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/02_he_tuning/run_supervised_from_configs.py \
    --config-jsons reports/results/fnn_he_targeted_best12_configs.json \
    --epochs 200 \
    --min-epochs 40 \
    --target-train-accuracy 0.995 \
    --target-patience 5 \
    --target-metric eval_train_accuracy \
    --device cuda \
    --log-every-epoch \
    --output reports/results/fnn_he_targeted_best12.json"
