#!/bin/bash
#SBATCH --job-name=recovery2_plain_sgd_cifar10_100L_nobn
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/05_sgd_recovery/run_plain_sgd_recovery2.py \
    --experiment recovery2_plain_sgd_cifar10_100L_nobn \
    --seed 42 \
    --device cuda \
    --output reports/results/recovery2_plain_sgd_cifar10_100L_nobn.json"
