#!/bin/bash
#SBATCH --job-name=row_centered_smoke4_cifar10_30L_bn
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:30:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/06_v2_row_centered/run_row_centered_audit_round4.py \
    --experiment row_centered_smoke4_cifar10_30L_bn \
    --seed 42 \
    --device cuda \
    --output reports/results/row_centered_smoke4_cifar10_30L_bn.json"
