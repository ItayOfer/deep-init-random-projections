#!/bin/bash
#SBATCH --job-name=v2_nobn_sgd_lr1e6_smoke_cifar10_30L
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/07_v2_eta_nobn/run_v2_nobn_sgd.py \
    --experiment v2_nobn_sgd_smoke_cifar10_30L \
    --lr 1e-6 \
    --seed 42 \
    --device cuda \
    --output reports/results/v2_nobn_sgd_lr1e6_smoke_cifar10_30L.json"
