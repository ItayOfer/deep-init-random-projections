#!/bin/bash
#SBATCH --job-name=rcfwd_lr3e1_smoke_cifar10_50L
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/09_rcfwd_rescale/run_rcfwd_gradrescale.py \
    --experiment rcfwd_rescale_smoke_cifar10_50L \
    --lr 0.3 \
    --seed 42 \
    --device cuda \
    --output reports/results/rcfwd_lr3e1_smoke_cifar10_50L.json"
