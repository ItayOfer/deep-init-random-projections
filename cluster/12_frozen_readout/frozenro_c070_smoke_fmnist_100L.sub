#!/bin/bash
#SBATCH --job-name=frozenro_c070_smoke_fmnist_100L
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/12_frozen_readout/run_frozen_readout.py \
    --experiment frozenro_c070_smoke_fmnist_100L \
    --seed 42 \
    --device cuda \
    --output reports/results/frozenro_c070_smoke_fmnist_100L.json"
