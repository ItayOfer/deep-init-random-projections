#!/bin/bash
#SBATCH --job-name=fnn_he_final
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/run_final.py \
    --epochs 200 \
    --diagnostics-every 10 \
    --seed 42 \
    --device cuda \
    --checkpoint-dir reports/checkpoints/final_audit \
    --checkpoint-every 50 \
    --output reports/results/final_audit.json"
