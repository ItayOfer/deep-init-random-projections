#!/bin/bash
#SBATCH --job-name=plain_sgd_100L_nobn_w512_cifar10
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:30:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/run_plain_sgd_100L.py \
    --experiment plain_sgd_100L_nobn_w512_cifar10 \
    --epochs 20 \
    --diagnostics-every 2 \
    --seed 42 \
    --device cuda \
    --output reports/results/plain_sgd_100L_nobn_w512_cifar10.json"
