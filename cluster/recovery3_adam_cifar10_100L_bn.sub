#!/bin/bash
#SBATCH --job-name=recovery3_adam_cifar10_100L_bn
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/run_adam_recovery3.py \
    --experiment recovery3_adam_cifar10_100L_bn \
    --seed 42 \
    --device cuda \
    --output reports/results/recovery3_adam_cifar10_100L_bn.json"
