#!/bin/bash
#SBATCH --job-name=row_centered_smoke_fmnist_30L_nobn
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --exclude=dgx01,dgx04
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:30:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python -u cluster/run_row_centered_audit.py \
    --experiment row_centered_smoke_fmnist_30L_nobn \
    --seed 42 \
    --device cuda \
    --output reports/results/row_centered_smoke_fmnist_30L_nobn.json"
