#!/bin/bash
#SBATCH --job-name=thesis_gpu_test
#SBATCH -p dlc
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:10:00
#SBATCH --output=%x-%j.out

set -euo pipefail

CONTAINER_IMAGE="${HOME}/nvidia_pt.sqsh"
CODE_DIR="${HOME}/thesis"

srun \
  --container-image="${CONTAINER_IMAGE}" \
  --container-mounts="${CODE_DIR}:/mount" \
  --container-workdir=/mount \
  bash -lc "python cluster/test_gpu.py"
